{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/", "destination": "/izihome/index.html" },
    { "source": "/css/:path*", "destination": "/izihome/css/:path*" },
    { "source": "/js/:path*", "destination": "/izihome/js/:path*" },
    { "source": "/images/:path*", "destination": "/izihome/images/:path*" }
  ]
}
